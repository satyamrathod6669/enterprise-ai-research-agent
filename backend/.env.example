# ---- LLM provider: groq | gemini | ollama ----
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Search provider: tavily | duckduckgo ----
# If SEARCH_PROVIDER=tavily but TAVILY_API_KEY is blank, the app automatically
# falls back to DuckDuckGo (zero setup, no key needed).
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
MAX_SOURCES_PER_QUESTION=6

# ---- Local embedding model (free, downloaded once from HuggingFace) ----
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Storage ----
DATA_DIR=../data
DATABASE_URL=

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8000
